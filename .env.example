# ===== Telegram API (obligatorio) =====
# Obtener en https://my.telegram.org/apps
TMD_API_ID=12345678
TMD_API_HASH=your_api_hash_here
TMD_PHONE=+34123456789

# ===== Canales de Telegram =====
# Formato JSON: [{"id": -100..., "name": "Nombre"}]
# TMD_CHANNELS=[{"id":-1002229558644,"name":"Las Cositas"}]

# ===== Rutas de almacenamiento =====
TMD_DOWNLOAD_PATH=/mnt/1234
TMD_EXTRACT_PATH=/mnt/1234

# ===== Servidor web =====
TMD_SERVER_HOST=0.0.0.0
TMD_SERVER_PORT=8000

# ===== Comportamiento =====
TMD_DOWNLOAD_PARALLEL=5
TMD_CONVERT_DTS=true
TMD_DELETE_ARCHIVES=true
TMD_STREAM_MAX=3

# ===== Logging =====
LOG_LEVEL=INFO
