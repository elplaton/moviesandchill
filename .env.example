# ==========================================
#  Movies & Chill — Configuracion (.env)
# ==========================================

# ----- Telegram API (obligatorio) -----
# Obtener en https://my.telegram.org/apps
TMD_API_ID=12345678
TMD_API_HASH=your_api_hash_here
TMD_PHONE=+34123456789

# ----- JWT (obligatorio) -----
# El servidor NO arranca sin esto. Generalo con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
TMD_JWT_SECRET=

# Password del usuario admin en el primer arranque (por defecto: admin)
TMD_ADMIN_PASSWORD=

# ----- PostgreSQL -----
TMD_DATABASE_URL=postgresql://movieapp:movieapp123@db:5432/moviesandchill

# ----- Almacenamiento -----
TMD_DOWNLOAD_PATH=/app/downloads
TMD_EXTRACT_PATH=/app/movies
# Estado persistente (descargas pausadas)
TMD_STATE_DIR=/app/state

# ----- Servidor -----
TMD_SERVER_HOST=0.0.0.0
TMD_SERVER_PORT=8000
# Origenes permitidos por CORS, separados por comas. Con "*" se desactivan
# las credenciales (la app usa Bearer, no cookies).
TMD_CORS_ORIGINS=*

# ----- Comportamiento -----
TMD_DOWNLOAD_PARALLEL=3
TMD_STREAM_MAX=3
TMD_CONVERT_DTS=true
TMD_DELETE_ARCHIVES=true

# ----- Logging -----
LOG_LEVEL=INFO

# ----- TMDB (opcional) -----
TMD_TMBD_API_KEY=your_tmdb_api_key_here
TMD_TMDB_ENABLED=false


# Barrido incremental de canales cada N horas (0 = nunca). Lo nuevo llega en tiempo real.
TMD_RESCAN_HOURS=6

# ----- Avisos de episodios nuevos (Web Push) -----
# Cada cuantos minutos se mira si han llegado episodios de las series que
# alguien sigue (0 = no avisar).
TMD_AVISOS_MINUTOS=10
# Correo de contacto que va dentro de la firma de cada aviso: lo exige el
# estandar de Web Push para que el servicio del fabricante sepa a quien
# escribir si algo va mal. No se muestra en ningun sitio.
TMD_PUSH_CONTACT=
# Las claves VAPID NO van aqui: se generan solas y se guardan en la tabla
# app_settings. Si cambiaran, todas las suscripciones de los navegadores
# dejarian de valer de golpe, y en Coolify el .env se regenera en cada
# redespliegue.
