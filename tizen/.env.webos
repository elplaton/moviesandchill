# URL del servidor Movies&Chill para el paquete de LG (webOS).
#
# Apunta al nginx del frontend (puerto 80) y no al backend por el 8000: desde
# que esto corre en Coolify, el 8000 del host lo ocupa el panel de Coolify y el
# backend solo se alcanza a traves del proxy, que reenvia /api. Es la misma
# direccion que .env.tizen; antes aqui habia otra IP y el puerto del backend, y
# con eso la app de LG no podia hablar con el servidor.
#
# Esta direccion es tambien de donde la app se baja la interfaz nueva al
# arrancar (/tv/), asi que tiene que ser la del nginx.
VITE_API_BASE=http://192.168.1.44

# Si la IP de casa no contesta (el DHCP la mueve, o la tele no esta en casa)
# se prueba el dominio. Ver main.tsx.
VITE_API_BASE_RESPALDO=https://moviesandchill.juanitoshomelab.com
