# URL del servidor Movies&Chill.
# Apunta al nginx del frontend (puerto 80), no al backend directo: desde que
# corre en Coolify el 8000 del host lo ocupa el panel de Coolify y el backend
# solo es accesible a traves del proxy. nginx reenvia /api al backend.
VITE_API_BASE=http://192.168.1.44

# Si la IP de casa no contesta (el DHCP la mueve, o la tele no esta en casa)
# se prueba el dominio. Ver main.tsx.
VITE_API_BASE_RESPALDO=https://moviesandchill.juanitoshomelab.com
